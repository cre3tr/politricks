---
// The shared page shell: head script (must run first), fonts, global
// styles, the header. Every page wraps its content in this.
// See devpost/spec.md > File Structure — BaseLayout is one of the files
// added beyond the spec's original tree (see checklist.md > Revisions),
// because every page needs the same <head> setup and there's no reason to
// repeat it.
import HeadScript from "../components/HeadScript.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<html lang="en">
  <head>
    <!-- The charset must come first in <head> (the HTML spec wants it in the
         first 1024 bytes, before any script), so Kenyan legal text's dashes
         and curly quotes never get misread. -->
    <meta charset="utf-8" />
    <!-- HeadScript comes straight after: it's a blocking inline script, so it
         still sets data-lang on <html> before the browser paints a pixel. -->
    <HeadScript />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Preloading the display font means it's already downloading before
         the CSS that references it is even parsed — it's small (subset to
         Latin) and used in the header on every page, so this is worth the
         extra request on cheap data. -->
    <link
      rel="preload"
      href="/fonts/anton-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <Header />
    <!-- The hackathon notice, every page (learner's wording, 2026-10-26). -->
    <div class="demo-banner" role="note">
      <p data-l="en" lang="en">Hackathon demo: proof of concept, not a finished service/product.</p>
      <p data-l="sw" lang="sw">Onyesho la hackathon: uthibitisho wa dhana, si huduma au bidhaa iliyokamilika. Hakiki vyanzo rasmi kabla ya kuchukua hatua.</p>
      <p data-l="sheng" lang="sw">Hii ni demo ya hackathon, project bado haijaisha. Check official sources kabla u-act</p>
    </div>
    <slot />
    <footer class="site-footer">
      <p>A demo for the Devpost Build With AI Basics hackathon, October 2026</p>
    </footer>
  </body>
</html>
