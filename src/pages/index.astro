---
// Home page (devpost/spec.md > Home Page, prd.md > Home: Active Bills and
// Una'tafuta?). Built ahead of time from every bill file in src/data/bills/.
//
// - Active Bills: every bill currently before Parliament (status "active"),
//   with chamber, stage and when that stage was last checked.
// - Recently passed: a plain list for now. Slice 9 turns this into the
//   Una'tafuta? search; until then it's how a reader reaches the Finance Act.
//
// A deadline countdown appears only once participation data exists (slice 6);
// until then the stage text carries the date, straight from the registry.
import BaseLayout from "../layouts/BaseLayout.astro";
import { BillSchema, type Bill } from "../lib/schema";

// Same validation as the bill pages: bad data fails the build.
const modules = import.meta.glob("../data/bills/*.json", { eager: true }) as Record<
  string,
  { default: unknown }
>;
const bills: Bill[] = Object.values(modules).map((mod) => BillSchema.parse(mod.default));

// Explicit, stable order (alphabetical by title) rather than file-name order.
const byTitle = (a: Bill, b: Bill) => a.title.localeCompare(b.title);
const active = bills.filter((bill) => bill.status === "active").sort(byTitle);
const passed = bills.filter((bill) => bill.status === "passed").sort(byTitle);

// Plain-language chamber labels. County comes in slice 11.
const CHAMBER: Record<Bill["chamber"], string> = {
  national: "National Assembly",
  senate: "Senate",
  county: "Nairobi County Assembly",
};

// Countdown only while participation is open (spec > Home Page): days left
// to the deadline, counted at build; the bill page's tab has the details.
const today = new Date().toISOString().slice(0, 10);
const daysLeft = (bill: Bill): number | null => {
  const p = bill.participation;
  if (!p?.open || !p.deadline || p.deadline < today) return null;
  return Math.round((Date.parse(p.deadline) - Date.parse(today)) / 86_400_000);
};

const checked = (iso: string) =>
  new Date(iso).toLocaleDateString("en-KE", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title="PoliTricks | Kenyan law, explained">
  <main class="home">
    {/* The page-level heading. The header wordmark is decorative, so the home
        page needs its own h1 for screen readers and search engines. */}
    <h1 class="home-title">PoliTricks</h1>
    <p class="lede">
      Kenyan law, explained beside the official text, in English, Kiswahili and Sheng.
    </p>

    {/* Una'tafuta? (slice 9): filters /search-index.json in the browser. The
        index is fetched on first use, so a visit that never searches never
        downloads it. Every query term must appear (AND), accents ignored. */}
    <section class="search" aria-labelledby="search-heading">
      <h2 id="search-heading">Una'tafuta?</h2>
      <input
        id="search"
        type="search"
        autocomplete="off"
        placeholder="e.g. HELB, tax, ushuru, finance"
        aria-describedby="search-help"
      />
      <p id="search-help" class="search-help">Search every bill by name or topic, in English, Kiswahili or Sheng.</p>
      <ul class="bill-list" id="search-results" aria-live="polite"></ul>
      {/* Cloned for each result, so results get the same scoped card styles
          as the server-rendered lists below. */}
      <template id="result-card">
        <li>
          <a class="bill-card" href="">
            <span class="chamber"><span class="passed-label" hidden>Passed</span> <span class="chamber-name"></span></span>
            <span class="title"></span>
            <span class="stage"></span>
          </a>
        </li>
      </template>
      <div class="no-results" id="no-results" hidden>
        <p data-l="en" lang="en">Hatujapata kitu: nothing found.</p>
        <p data-l="sw" lang="sw">Hatujapata kitu.</p>
        <p data-l="sheng" lang="sw-x-sheng">Hatujapata kitu.</p>
        <button type="button" id="clear-search">Clear search</button>
      </div>
    </section>

    <section aria-labelledby="active-heading">
      <h2 id="active-heading">Active Bills</h2>
      {active.length === 0 && <p class="empty">No bills are open before Parliament right now.</p>}
      <ul class="bill-list">
        {
          active.map((bill) => (
            <li>
              <a class="bill-card" href={`/bills/${bill.id}`}>
                <span class="chamber">{CHAMBER[bill.chamber]}</span>
                <span class="title">{bill.title}</span>
                <span class="stage">{bill.stage}</span>
                {daysLeft(bill) === null ? (
                  <span class="window">Participation not open</span>
                ) : (
                  <span class="window window-open">
                    {daysLeft(bill)} day(s) left to have your say (by {checked(bill.participation!.deadline!)})
                  </span>
                )}
                <span class="checked">Last checked {checked(bill.stage_checked_at)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="passed-heading">
      <h2 id="passed-heading">Recently passed</h2>
      <ul class="bill-list">
        {
          passed.map((bill) => (
            <li>
              <a class="bill-card" href={`/bills/${bill.id}`}>
                <span class="chamber">
                  <span class="passed-label">Passed</span> {CHAMBER[bill.chamber]}
                </span>
                <span class="title">{bill.title}</span>
                <span class="stage">{bill.stage}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<script>
  type Entry = { id: string; title: string; chamber: string; status: "active" | "passed"; stage: string; text: string };

  // Must fold exactly like src/pages/search-index.json.ts does.
  const fold = (text: string) =>
    text.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase().replace(/\s+/g, " ").trim();
  const CHAMBER: Record<string, string> = { national: "National Assembly", senate: "Senate", county: "Nairobi County Assembly" };

  const input = document.getElementById("search") as HTMLInputElement;
  const results = document.getElementById("search-results") as HTMLUListElement;
  const none = document.getElementById("no-results") as HTMLElement;
  let index: Entry[] | null = null;

  async function load(): Promise<Entry[]> {
    if (!index) {
      try {
        index = (await (await fetch("/search-index.json")).json()) as Entry[];
      } catch {
        index = [];
      }
    }
    return index;
  }

  const template = document.getElementById("result-card") as HTMLTemplateElement;

  function card(entry: Entry): HTMLLIElement {
    const li = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    li.querySelector<HTMLAnchorElement>(".bill-card")!.href = `/bills/${entry.id}`;
    li.querySelector<HTMLElement>(".passed-label")!.hidden = entry.status !== "passed";
    li.querySelector<HTMLElement>(".chamber-name")!.textContent = CHAMBER[entry.chamber] ?? entry.chamber;
    li.querySelector<HTMLElement>(".title")!.textContent = entry.title;
    li.querySelector<HTMLElement>(".stage")!.textContent = entry.stage;
    return li;
  }

  async function search() {
    const terms = fold(input.value).split(" ").filter(Boolean);
    if (terms.length === 0) {
      results.replaceChildren();
      none.hidden = true;
      return;
    }
    const hits = (await load()).filter((entry) => terms.every((term) => entry.text.includes(term)));
    results.replaceChildren(...hits.map(card));
    none.hidden = hits.length > 0;
  }

  input.addEventListener("input", search);
  document.getElementById("clear-search")!.addEventListener("click", () => {
    input.value = "";
    search();
    input.focus();
  });
</script>

<style>
  .search {
    margin-bottom: 2rem;
  }
  .search input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem;
    font-size: 1rem;
    border: 2px solid var(--flag-black);
    border-radius: 6px;
  }
  .search-help {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.4rem 0 0.75rem;
  }
  .no-results button {
    border: 1px solid var(--flag-black);
    background: var(--paper);
    padding: 0.4rem 1rem;
    border-radius: 4px;
    cursor: pointer;
  }
  .home {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  .home-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 2rem;
    margin: 0 0 0.25rem;
  }
  .empty {
    color: var(--muted);
  }
  .window {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--muted);
  }
  .window-open {
    color: var(--flag-green);
  }
  .lede {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  h2 {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.5rem;
    margin: 1.75rem 0 0.75rem;
  }
  .bill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  /* Each bill is one big tap target: easy on a phone. The left rule uses the
     flag colours — green for active, black for passed — never party colours. */
  .bill-card {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid #ddd;
    border-left: 6px solid var(--flag-green);
    border-radius: 6px;
    color: var(--flag-black);
    text-decoration: none;
    background: var(--paper);
  }
  section[aria-labelledby="passed-heading"] .bill-card {
    border-left-color: var(--flag-black);
  }
  .bill-card:hover,
  .bill-card:focus-visible {
    border-color: var(--flag-black);
  }
  .chamber {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .title {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .stage {
    font-size: 0.95rem;
  }
  .checked {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .passed-label {
    display: inline-block;
    background: var(--flag-black);
    color: var(--paper);
    padding: 0 0.4rem;
    border-radius: 3px;
    margin-right: 0.25rem;
  }
</style>
