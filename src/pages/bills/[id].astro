---
// The bill page (devpost/spec.md > Bill Page). Slice 2a builds just "What
// it does" — no tabs yet (What changed / Have your say arrive in slices 6
// and 8). Every bill JSON is Zod-validated HERE, at build time: a broken
// file fails `npm run build` and names exactly which file broke, rather than
// shipping a page that silently renders `undefined`.
import { z } from "zod";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClauseCard from "../../components/ClauseCard.astro";
import ChangeRow from "../../components/ChangeRow.astro";
import GroupsPanel from "../../components/GroupsPanel.astro";
import BillTabs from "../../components/BillTabs.astro";
import ParticipationPanel from "../../components/ParticipationPanel.astro";
import ArticleSheet from "../../components/ArticleSheet.astro";
import MotionCard from "../../components/MotionCard.astro";
import constitutionJson from "../../data/constitution.json";
import SourceFingerprint from "../../components/SourceFingerprint.astro";
import { BillSchema, ConstitutionSchema, type Bill } from "../../lib/schema";
import { badgeFor } from "../../lib/badge";
import { displayStatus, summarySha256 } from "../../lib/reviewHash";

export async function getStaticPaths() {
  // Eager: every bill file is read and validated right now, at build time —
  // not lazily per-request, since the whole site is prebuilt (devpost/spec.md
  // > How This Works).
  const modules = import.meta.glob("../../data/bills/*.json", { eager: true }) as Record<
    string,
    { default: unknown }
  >;

  return Object.entries(modules).map(([path, mod]) => {
    const result = BillSchema.safeParse(mod.default);
    if (!result.success) {
      // Thrown during the Astro build, so this stops `npm run build` cold —
      // this IS the "broken bill JSON fails the build and names the file"
      // behaviour the checklist verifies.
      throw new Error(`Invalid bill data in ${path}:\n${z.prettifyError(result.error)}`);
    }
    const bill = result.data;
    // The filename stem is the bill's id everywhere else in the pipeline
    // (pipeline/politricks/models.py > bill_path). A file that doesn't
    // agree with its own contents is exactly the kind of drift Iron Law VI
    // exists to catch — check it here too, not just by convention.
    const stem = path.split("/").pop()!.replace(/\.json$/, "");
    if (bill.id !== stem) {
      throw new Error(`Invalid bill data in ${path}:\nbill.id ("${bill.id}") does not match filename ("${stem}")`);
    }
    return { params: { id: bill.id }, props: { bill } };
  });
}

interface Props {
  bill: Bill;
}

const { bill } = Astro.props;

// "Any item is a sample" drives the sample-explainer banner. Slice 2a only
// ever populates `summary` and `clauses` (groups/changes/participation are
// later slices), so those two are what's checked.
const hasSample =
  bill.summary?.review.status === "sample" ||
  bill.clauses.some((clause) => clause.review.status === "sample");

// Only the articles this bill's clauses suggest go into the page (spec >
// Bill Page, Payload). An unknown number fails the build: generate validates
// against the same file, so it would mean the two have drifted.
const constitution = ConstitutionSchema.parse(constitutionJson);
const suggested = [...new Set(bill.clauses.flatMap((clause) => clause.suggested_articles))].sort((a, b) => a - b);
const pageArticles = suggested.map((number) => {
  const article = constitution.articles.find((candidate) => candidate.number === number);
  if (!article) throw new Error(`${bill.id}: suggested article ${number} is not in constitution.json`);
  return article;
});

// The text the clauses above were cut from. A source read by OCR (slice 8) is
// not one of them: it is only the "after" of the What changed tab, and listing
// it under "Text shown" would claim the clauses came from it.
const clauseSources = bill.sources.filter((source) => !source.ocr);
const ocrSource = bill.sources.find((source) => source.ocr) ?? null;
// What the What changed tab compares, said once above the rows.
const changesSourceLabel = bill.changes[0]?.source_label ?? "";
const changesHaveOcr = bill.changes.some((change) => change.ocr);

const summaryBadge = bill.summary
  ? badgeFor(displayStatus(bill.summary.review, await summarySha256(bill.summary)))
  : null;
---
<BaseLayout title={`${bill.title} | PoliTricks`}>
  <main class="bill-page">
    <div class="bill-title-row">
      <h1>{bill.title}</h1>
      <span class={`status-label status-${bill.status}`}>
        {bill.status === "passed" ? "Passed" : "Active"}
      </span>
    </div>
    <p class="stage">{bill.stage}</p>
    {/* Which official text the clauses below come from — shown up here, next to
        the clauses, not only in the footer. For the Public Participation Bill
        the label carries the caveat that this is the first-published text, not
        the version now before the Senate. */}
    <p class="text-shown">
      Text shown: {clauseSources.map((source) => source.label).join("; ")}
    </p>

    {
      bill.source_changed && (
        <p class="banner banner-changed" role="status">
          The official document changed since we last checked. Explanations may be
          out of date.
        </p>
      )
    }

    {
      hasSample && (
        <p class="banner banner-sample" role="status">
          Explanations marked Sample are hand-written placeholders, not AI output
          and not yet reviewed.
        </p>
      )
    }

    {/* A county motion has no clauses, drafts or tabs: just the Motion Card. */}
    {bill.kind === "motion" ? (
      <MotionCard bill={bill} />
    ) : (
    <>
    <BillTabs passed={bill.status === "passed"} />

    <section id="what-it-does" class="tab-panel" aria-labelledby="tab-what-it-does">
    <h2 class="section-heading">What it does</h2>

    {
      bill.summary && (
        <section class="summary-card" aria-labelledby="in-short-heading">
          <h2 id="in-short-heading" class="summary-heading">
            <span data-l="en" lang="en">In short</span>
            <span data-l="sw" lang="sw">Kwa ufupi</span>
            <span data-l="sheng" lang="sw-x-sheng">Kwa ufupi</span>
          </h2>
          {summaryBadge && (
            <span class={`badge ${summaryBadge.className}`}>{summaryBadge.label}</span>
          )}
          <p data-l="en" lang="en">
            {bill.summary.text.en}
          </p>
          <p data-l="sw" lang="sw">
            {bill.summary.text.sw}
          </p>
          <p data-l="sheng" lang="sw-x-sheng">
            {bill.summary.text.sheng}
          </p>
        </section>
      )
    }

    <GroupsPanel bill={bill} />

    {/* The Match script below fills this note, floats matching cards to the
        top of the list, tags them "Matches you" and opens the top three; with
        no words, or if the call fails, nothing moves. */}
    <p class="match-status" data-match-status hidden></p>
    <div class="clause-list" data-clause-list data-bill-id={bill.id}>
      {bill.clauses.map((clause) => <ClauseCard clause={clause} billId={bill.id} />)}
    </div>
    </section>

    {/* From changes[] (slice 8, `politricks compare`); a bill with none keeps
        the honest one-version note. */}
    <section id="what-changed" class="tab-panel" aria-labelledby="tab-what-changed">
      <h2 class="section-heading">What changed</h2>
      {
        bill.changes.length === 0 ? (
          <>
            <p data-l="en" lang="en">Only one version so far. We'll show the changes when the next draft is published.</p>
            <p data-l="sw" lang="sw">Kuna toleo moja tu kwa sasa. Tutaonyesha mabadiliko toleo lijalo likichapishwa.</p>
            <p data-l="sheng" lang="sw-x-sheng">Kuna version moja tu saa hii. Tuta-show changes next draft ikitoka.</p>
          </>
        ) : (
          <>
            <p class="changes-intro" data-changes-intro>
              <span data-l="en" lang="en">Versions: {changesSourceLabel}.</span>
              <span data-l="sw" lang="sw">Matoleo: {changesSourceLabel}.</span>
              <span data-l="sheng" lang="sw-x-sheng">Versions: {changesSourceLabel}.</span>
            </p>
            <p class="changes-intro">
              <span data-l="en" lang="en">
                Only the clauses that differ are listed.{changesHaveOcr ? " A clause that is not listed has no difference we could tell apart from a scanning error." : " A clause that is not listed reads the same in both versions."}
              </span>
              <span data-l="sw" lang="sw">
                Ni vifungu vinavyotofautiana tu vilivyoorodheshwa.{changesHaveOcr ? " Kifungu ambacho hakijaorodheshwa hakina tofauti tunayoweza kutofautisha na kosa la kuskani." : " Kifungu ambacho hakijaorodheshwa kinasomeka sawa katika matoleo yote mawili."}
              </span>
              <span data-l="sheng" lang="sw-x-sheng">
                Ni clauses zinazo-differ tu zimeorodheshwa.{changesHaveOcr ? " Clause ambayo haijaorodheshwa haina difference tunaweza kutofautisha na scanning error." : " Clause ambayo haijaorodheshwa inasoma sawa kwa versions zote mbili."}
              </span>
            </p>
            <div class="change-list" data-change-list>
              {bill.changes.map((change) => <ChangeRow change={change} ocrSource={ocrSource} />)}
            </div>
          </>
        )
      }
    </section>

    <section id="have-your-say" class="tab-panel" aria-labelledby="tab-have-your-say">
      <h2 class="section-heading">{bill.status === "passed" ? "Where it can still be challenged" : "Have your say"}</h2>
      <ParticipationPanel bill={bill} />
    </section>
    </>
    )}

    <ArticleSheet articles={pageArticles} constitution={constitution} />
    <SourceFingerprint sources={bill.sources} />
  </main>
</BaseLayout>

<script>
  // Match (devpost/spec.md > Match API): the reader's own words from their
  // profile float the clauses that fit them to the top of the list. The
  // answer is cached per bill and per words (first 16 hex characters of the
  // SHA-256 of the cleaned words), so a return visit makes no call. Any
  // failure, or 15 s with no answer, leaves the fixed order and says so quietly.
  import { getCached, getProfile, setCached } from "../../lib/storage";

  const list = document.querySelector<HTMLElement>("[data-clause-list]");
  const status = document.querySelector<HTMLElement>("[data-match-status]");
  const words = getProfile()?.words ?? "";

  function say(texts: { en: string; sw: string; sheng: string }) {
    if (!status) return;
    status.replaceChildren(
      ...(["en", "sw", "sheng"] as const).map((lang) => {
        const span = document.createElement("span");
        span.dataset.l = lang;
        span.lang = lang === "sheng" ? "sw-x-sheng" : lang;
        span.textContent = texts[lang];
        return span;
      }),
    );
    status.hidden = false;
  }

  async function wordsKey(billId: string, cleaned: string): Promise<string> {
    const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(cleaned));
    const hex = Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("");
    return `pt.match.${billId}.${hex.slice(0, 16)}`;
  }

  async function match() {
    if (!list || !words) return;
    const billId = list.dataset.billId!;
    const key = await wordsKey(billId, words);
    let ids = getCached<string[]>(key);
    if (!ids) {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 15_000);
      try {
        const response = await fetch("/api/match", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ bill_id: billId, words }),
          signal: controller.signal,
        });
        if (response.ok) {
          ids = ((await response.json()) as { clause_ids: string[] }).clause_ids;
          setCached(key, ids);
        }
      } catch {
        // Network error or timeout: fall through to the quiet note.
      } finally {
        clearTimeout(timer);
      }
    }
    if (!ids) {
      say({
        en: "Couldn't personalise right now.",
        sw: "Haikuwezekana kupanga kulingana nawe kwa sasa.",
        sheng: "Hatukuweza ku-personalise saa hii.",
      });
      return;
    }
    if (ids.length === 0) return;
    // Reverse so the strongest match ends up first.
    [...ids].reverse().forEach((id) => {
      const card = list.querySelector<HTMLElement>(`[data-clause-id="${CSS.escape(id)}"]`);
      if (!card) return;
      card.classList.add("matched");
      card.querySelector<HTMLElement>(".match-note")?.removeAttribute("hidden");
      list.prepend(card);
    });
    // The top 3 cards that really exist open by themselves (ids can name a
    // clause this page doesn't have). Opening an unexplained card also starts
    // its Explain call (ClauseCard's script listens for the toggle).
    ids
      .map((id) => list.querySelector<HTMLElement>(`[data-clause-id="${CSS.escape(id)}"]`))
      .filter((card): card is HTMLElement => card !== null)
      .slice(0, 3)
      .forEach((card) => {
        const details = card.querySelector<HTMLDetailsElement>(":scope > details");
        if (details) details.open = true;
      });
    say({
      en: `Sections matching "${words}" come first.`,
      sw: `Vifungu vinavyolingana na "${words}" vimewekwa kwanza.`,
      sheng: `Sections zinazo-match "${words}" ziko first.`,
    });
  }

  match();
</script>

<style>
  .match-status {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .bill-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 1rem;
  }
  .bill-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .bill-title-row h1 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.02em;
    font-size: 1.8rem;
    margin: 0;
  }
  .status-label {
    font-size: 0.8rem;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    border: 1px solid currentColor;
  }
  .status-passed {
    color: var(--flag-green);
  }
  .status-active {
    color: var(--matatu-brown);
  }
  .text-shown {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }
  .stage {
    color: var(--muted);
    margin-top: 0.25rem;
  }
  .banner {
    border: 1px solid var(--flag-red);
    background: color-mix(in srgb, var(--flag-red) 8%, var(--paper));
    padding: 0.6rem 0.8rem;
    border-radius: 4px;
    font-size: 0.9rem;
    margin-top: 0.75rem;
  }
  .banner-sample {
    border-color: var(--muted);
    background: color-mix(in srgb, var(--muted) 8%, var(--paper));
  }
  .section-heading {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-top: 2rem;
  }
  .summary-card {
    border: 1px solid var(--flag-black);
    border-radius: 4px;
    padding: 1rem;
    margin-bottom: 1.5rem;
  }
  .summary-heading {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.02em;
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
  }
  .summary-heading :global([data-l]) {
    display: none;
  }
  :global(html:not([data-lang])) .summary-heading :global([data-l="en"]),
  :global(html[data-lang="en"]) .summary-heading :global([data-l="en"]),
  :global(html[data-lang="sw"]) .summary-heading :global([data-l="sw"]),
  :global(html[data-lang="sheng"]) .summary-heading :global([data-l="sheng"]) {
    display: inline;
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    border: 1px solid var(--muted);
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .badge-draft {
    border-color: var(--matatu-brown);
    color: var(--matatu-brown);
  }
  .badge-reviewed {
    border-color: var(--flag-green);
    color: var(--flag-green);
  }
  .badge-sample {
    border-style: dashed;
    border-color: var(--muted);
    color: var(--muted);
  }
  .changes-intro {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0.25rem 0 0.75rem;
  }
</style>
