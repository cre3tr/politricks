---
// The three tabs on a bill page (devpost/spec.md > Bill Page): What it does,
// What changed, Have your say (Where it can still be challenged, for a law).
//
// Progressive enhancement: the three panels are ordinary sections in the
// page, all visible without JavaScript. This script turns them into tabs
// and keeps the open one in the URL hash, so "#have-your-say" can be linked
// from the home page.
interface Props {
  passed: boolean;
}

const { passed } = Astro.props;
const tabs = [
  { id: "what-it-does", en: "What it does", sw: "Unafanya nini", sheng: "Inafanya nini" },
  { id: "what-changed", en: "What changed", sw: "Nini kimebadilika", sheng: "Nini imechange" },
  passed
    ? { id: "have-your-say", en: "Where it can still be challenged", sw: "Inaweza kupingwa wapi", sheng: "Inaweza ku-challengiwa wapi" }
    : { id: "have-your-say", en: "Have your say", sw: "Toa maoni yako", sheng: "Sema view yako" },
];
---
<nav class="bill-tabs" role="tablist" aria-label="Bill sections">
  {
    tabs.map((tab, index) => (
      <button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={tab.id} aria-selected={index === 0 ? "true" : "false"} data-tab={tab.id}>
        <span data-l="en" lang="en">{tab.en}</span>
        <span data-l="sw" lang="sw">{tab.sw}</span>
        <span data-l="sheng" lang="sw-x-sheng">{tab.sheng}</span>
      </button>
    ))
  }
</nav>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".bill-tabs [data-tab]"));
  const panels = buttons.map((button) => document.getElementById(button.dataset.tab!)).filter(Boolean) as HTMLElement[];

  function show(id: string, updateHash: boolean) {
    if (!panels.some((panel) => panel.id === id)) id = panels[0]?.id ?? id;
    buttons.forEach((button) => button.setAttribute("aria-selected", String(button.dataset.tab === id)));
    panels.forEach((panel) => {
      panel.hidden = panel.id !== id;
      panel.setAttribute("role", "tabpanel");
    });
    if (updateHash) history.replaceState(null, "", id === panels[0]?.id ? location.pathname : `#${id}`);
  }

  buttons.forEach((button) => button.addEventListener("click", () => show(button.dataset.tab!, true)));
  // A clause anchor (#clause-c3) lives in the first tab.
  const hash = location.hash.slice(1);
  show(hash.startsWith("clause-") ? "what-it-does" : hash, false);
  window.addEventListener("hashchange", () => {
    const next = location.hash.slice(1);
    show(next.startsWith("clause-") ? "what-it-does" : next, false);
  });
</script>

<style>
  .bill-tabs {
    display: flex;
    gap: 0.25rem;
    margin-top: 1.5rem;
    border-bottom: 2px solid var(--rule);
    overflow-x: auto;
    /* The tabs still scroll sideways when the labels are long, but no
       scrollbar is drawn: it would sit on top of the red bar under the open
       tab. The label cut off at the right edge is the cue to swipe. */
    scrollbar-width: none;
  }
  .bill-tabs::-webkit-scrollbar {
    display: none;
  }
  .bill-tabs button {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0;
    font-size: 1rem;
    padding: 0.5rem 0.9rem;
    border: none;
    border-radius: 8px 8px 0 0;
    background: var(--paper);
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
    min-height: 2.75rem;
  }
  .bill-tabs button:hover {
    background: var(--tint-red);
    color: var(--flag-black);
  }
  /* The open tab: black text and a thick flag-red bar along its foot. */
  .bill-tabs button[aria-selected="true"] {
    background: var(--paper);
    color: var(--flag-black);
    box-shadow: inset 0 -4px 0 var(--flag-red);
  }
  .bill-tabs button:focus-visible {
    outline-offset: -3px;
  }
  /* Press feedback on tap. */
  .bill-tabs button {
    transition:
      background-color 0.15s,
      color 0.15s,
      transform 0.12s;
  }
  .bill-tabs button:active {
    transform: scale(0.95);
  }
  /* A short fade whenever a panel becomes the visible one (display:none to
     shown restarts the animation). Opacity only, so no stacking surprises for
     the sticky header or in-page anchors. Without JS every panel is shown and
     this is a one-time fade on load. */
  :global(.tab-panel:not([hidden])) {
    animation: pt-tab-fade 0.22s ease-out;
  }
  @keyframes pt-tab-fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bill-tabs button {
      transition: none;
    }
    .bill-tabs button:active {
      transform: none;
    }
    :global(.tab-panel:not([hidden])) {
      animation: none;
    }
  }
  .bill-tabs :global([data-l]) {
    display: none;
  }
  :global(html:not([data-lang])) .bill-tabs :global([data-l="en"]),
  :global(html[data-lang="en"]) .bill-tabs :global([data-l="en"]),
  :global(html[data-lang="sw"]) .bill-tabs :global([data-l="sw"]),
  :global(html[data-lang="sheng"]) .bill-tabs :global([data-l="sheng"]) {
    display: inline;
  }
</style>
