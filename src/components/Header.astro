---
// The site header: the Anton wordmark, the thin flag stripe, and the global
// language toggle. See devpost/spec.md > Look and Feel — Anton for the
// wordmark, the flag palette tokens for the stripe, "no orange/yellow as a
// dominant colour" is why the stripe is black/red/green with white
// separators rather than a literal Kenyan-flag black/red/green/white block.
//
// Sticky (learner's call at the final review, 2026-10-26): the language
// switch stays in reach while reading a long bill.
import LanguageToggle from "./LanguageToggle.astro";
---
<header class="site-header">
  <div class="flag-stripe" aria-hidden="true">
    <span class="stripe stripe-black"></span>
    <span class="stripe stripe-sep"></span>
    <span class="stripe stripe-red"></span>
    <span class="stripe stripe-sep"></span>
    <span class="stripe stripe-green"></span>
  </div>
  <div class="header-row">
    <a href="/" class="wordmark">POLITRICKS</a>
    <LanguageToggle />
  </div>
</header>

<style>
  /* Pinned to the top. The article sheet is a native <dialog>, which renders
     in the top layer, so it still opens above this. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    box-shadow: 0 1px 0 #e2ded8;
  }
  .flag-stripe {
    display: flex;
    height: 6px;
  }
  .stripe {
    flex: 1;
  }
  .stripe-sep {
    flex: 0 0 2px;
    background: var(--paper);
  }
  .stripe-black {
    background: var(--flag-black);
  }
  .stripe-red {
    background: var(--flag-red);
  }
  .stripe-green {
    background: var(--flag-green);
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem;
  }
  .wordmark {
    font-family: var(--font-wordmark);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    color: var(--flag-black);
    text-decoration: none;
    line-height: 1;
  }
</style>
